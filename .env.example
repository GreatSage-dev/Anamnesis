PORT=3000
NODE_ENV=development
XLAYER_RPC_URL=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952
OKLINK_API_KEY=
OKLINK_BASE_URL=https://www.oklink.com/api/v5/explorer
X402_PAYMENT_WALLET=0x71C7656EC7ab88b098defB751B7401B5f6d8976F
X402_PRICE_USDT=0.01

# ─── Anamnesis: Decision Memory Layer ────────────────────────────────
ANAMNESIS_ENABLED=true

# CockroachDB Cloud (free tier)
# Get connection string from: https://cockroachlabs.cloud
DATABASE_URL=postgresql://username:password@cluster-host:26257/defaultdb?sslmode=verify-full

# AWS Bedrock
# Ensure model access is enabled in AWS Bedrock Console -> Model Access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AWS_BEDROCK_LLM_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v1:0
